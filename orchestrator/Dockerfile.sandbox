FROM python:3.11-slim

WORKDIR /app

# Install FastAPI + test dependencies matching the generated service
RUN pip install --no-cache-dir \
    fastapi>=0.110.0 \
    uvicorn>=0.27.0 \
    pydantic>=2.5.0 \
    requests==2.32.5 \
    httpx>=0.27.0 \
    pytest>=8.0.0 \
    pytest-asyncio>=0.23.0 \
    starlette

# Copy the generated app directory (build context = app_dir in pipeline.py)
COPY . .

# --network=none is enforced at runtime by pipeline.py
CMD ["pytest", "tests/", "-v", "--tb=short"]